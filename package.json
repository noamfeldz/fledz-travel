{
  "name": "fledz-travel",
  "private": true,
  "version": "0.0.21",
  "type": "module",
  "scripts": {
    "predev": "npx kill-port 3022 6022",
    "dev": "concurrently \"vite\" \"cd backend && node --watch server.js\" --names \"frontend,backend\" --prefix-colors \"cyan,yellow\"",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "maps:check": "node scripts/check-google-maps-key.mjs",
    "test": "node --test backend/tests/ai-utils.test.js",
    "test:record-fixtures": "node scripts/record-ai-fixtures.mjs"
  },
  "dependencies": {
    "framer-motion": "^12.38.0",
    "leaflet": "^1.9.4",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-leaflet": "^5.0.0",
    "react-router-dom": "^7.14.2"
  },
  "devDependencies": {
    "@types/leaflet": "^1.9.20",
    "@types/react": "^19.1.2",
    "@types/react-dom": "^19.1.2",
    "@vitejs/plugin-react": "^5.0.0",
    "concurrently": "^9.2.1",
    "typescript": "~5.8.3",
    "vite": "^7.0.0"
  }
}
